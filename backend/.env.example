# ==============================================================================
# FastAPI Backend Template - Environment Configuration Example
# ==============================================================================
# This file serves as a template for your local .env file.
# Copy this file to .env and update the values to match your local setup.
# ==============================================================================

# ------------------------------------------------------------------------------
# Project Settings
# ------------------------------------------------------------------------------
PROJECT_NAME="DraftAI"
STACK_NAME="draftai"
DOMAIN="draftai.test"
# Environment: local, staging, production
ENVIRONMENT="local"

# ------------------------------------------------------------------------------
# Frontend Integration
# ------------------------------------------------------------------------------
# Used by the backend to generate links in emails to the frontend
FRONTEND_HOST="http://localhost:5173"

# ------------------------------------------------------------------------------
# API Configuration
# ------------------------------------------------------------------------------
API_V1_STR="/api/v1"
# Comma-separated list of allowed origins for CORS
BACKEND_CORS_ORIGINS="http://localhost,http://localhost:5173,http://localhost:5174,http://localhost:5175,https://localhost,https://localhost:5173"

# ------------------------------------------------------------------------------
# Security & Authentication
# ------------------------------------------------------------------------------
# Generate a secret key using: openssl rand -hex 32
SECRET_KEY="changethis"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ------------------------------------------------------------------------------
# Initial Super User (Created on startup)
# ------------------------------------------------------------------------------
SUPER_USER_NAME="Admin"
SUPER_USER_EMAIL="admin@example.com"
SUPER_USER_PASSWORD="changethis"

# ------------------------------------------------------------------------------
# Database (PostgreSQL)
# ------------------------------------------------------------------------------
POSTGRES_SERVER="db"
# Use "localhost" if running the fastapi backend locally instead of in Docker
# POSTGRES_SERVER="localhost"
POSTGRES_PORT=5432
POSTGRES_DB="draftai_db"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="changethis"
# SSL Mode: disable, prefer, require, verify-ca, verify-full
POSTGRES_SSLMODE="prefer"

# ------------------------------------------------------------------------------
# Redis (ARQ job queue)
# ------------------------------------------------------------------------------
REDIS_HOST="redis"
REDIS_PORT=6379
REDIS_DB=0

# ------------------------------------------------------------------------------
# Database Management (pgAdmin)
# ------------------------------------------------------------------------------
PGADMIN_EMAIL="admin@example.com"
PGADMIN_PASSWORD="changethis"

# ------------------------------------------------------------------------------
# Email Configuration (SMTP)
# ------------------------------------------------------------------------------
SMTP_HOST="localhost"
SMTP_PORT=1025
SMTP_USER=""
SMTP_PASSWORD=""
SMTP_TLS=False
SMTP_SSL=False
EMAILS_FROM_EMAIL="admin@example.com"
EMAIL_RESET_TOKEN_EXPIRE_HOURS=48

# ------------------------------------------------------------------------------
# Object Storage (MinIO locally, S3/Blob in production)
# ------------------------------------------------------------------------------
S3_ENDPOINT_URL="http://minio:9000"
# Browser-facing endpoint for presigned URLs (use localhost when API runs in Docker)
S3_PUBLIC_ENDPOINT_URL="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET_NAME="draftai-covers"
S3_REGION="us-east-1"
S3_PRESIGNED_URL_EXPIRE_SECONDS=3600

# Public API URL reachable by DEV.to when publishing cover images.
# Required for DEV.to cover images at publish time (not needed for in-app preview).
# DEV.to must fetch this URL from the public internet — localhost/MinIO URLs do not work.
# Local dev: expose port 8000 via ngrok/Cloudflare tunnel, e.g. PUBLIC_API_BASE_URL="https://abc123.ngrok-free.app"
# Production: https://api.yourdomain.com
PUBLIC_API_BASE_URL=

# LinkedIn auto-publish (optional). If unset, DraftAI stays in copy-to-clipboard mode.
# Leave AUTHOR_URN empty to auto-detect your profile from the access token (openid + profile scopes).
# Personal profile: urn:li:person:<id> — token needs w_member_social
# Company page: urn:li:organization:<numeric-id> — token needs w_organization_social
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_AUTHOR_URN=

# Google cover images — aspect ratio for Gemini image API (default cover model lives in DB catalog)
GEMINI_IMAGE_ASPECT_RATIO="16:9"

# ------------------------------------------------------------------------------
# AI HTTP timeouts (seconds)
# ------------------------------------------------------------------------------
AI_TEXT_GENERATION_TIMEOUT_SECONDS=120
AI_GEMINI_IMAGE_GENERATION_TIMEOUT_SECONDS=180
AI_OPENAI_IMAGE_GENERATION_TIMEOUT_SECONDS=120
AI_OPENAI_IMAGE_DOWNLOAD_TIMEOUT_SECONDS=60
AI_MODEL_DISCOVERY_TIMEOUT_SECONDS=15
AI_OLLAMA_TIMEOUT_SECONDS=10
ARQ_JOB_TIMEOUT_SECONDS=600
AI_MIN_TEXT_CONTEXT_WINDOW_TOKENS=16384
COVER_TEMPLATE_FALLBACK_ENABLED=true
COVER_TEMPLATE_WIDTH=1280
COVER_TEMPLATE_HEIGHT=720
COVER_UPLOAD_MAX_BYTES=5242880

# Local Ollama (OpenAI-compatible). Use host.docker.internal when backend runs in Docker.
OLLAMA_BASE_URL="http://localhost:11434/v1"

# ------------------------------------------------------------------------------
# Credential Encryption (optional — derived from SECRET_KEY if unset)
# ------------------------------------------------------------------------------
# CREDENTIALS_ENCRYPTION_KEY=

# ------------------------------------------------------------------------------
# Error Tracking (Sentry)
# ------------------------------------------------------------------------------
SENTRY_DSN=""
